# Copy this file to `.env` and fill in the node details, then run `rfbwallet init`.

# Network: regtest (default) | testnet | signet. Mainnet is rejected.
NETWORK=regtest

# Bitcoin Core RPC endpoint, host:port.
RPC_URL=127.0.0.1:18443

# RPC auth. Use EITHER a cookie file path (recommended for local nodes) ...
RPC_COOKIE=/home/youruser/.bitcoin/regtest/.cookie
# ... OR an rpcuser / rpcpassword pair (leave RPC_COOKIE blank to use these).
# RPC_USER=rfb
# RPC_PASS=rfb

# BIP39 mnemonic. Leave blank; `rfbwallet init` generates one and writes it here.
# To import an existing wallet, paste its mnemonic instead.
MNEMONIC=

# Optional BIP39 passphrase (the "25th word"). Usually blank.
# PASSPHRASE=

# Descriptor type: wpkh (BIP84 native SegWit, default) | tr (BIP86 Taproot).
# `rfbwallet init --taproot` sets this to `tr` for you.
DESCRIPTOR_KIND=wpkh

# SQLite database that stores wallet state between runs.
DB_PATH=wallet.sqlite

# Earliest block height to sync from. 0 is fine for regtest; on testnet set a
# height close to when the wallet was created so the first sync is not the whole
# chain.
START_HEIGHT=0
