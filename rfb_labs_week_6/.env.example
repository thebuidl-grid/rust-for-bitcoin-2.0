cat > .env.example << 'EOF'
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=polaruser
BITCOIN_RPC_PASSWORD=polarpass
BITCOIN_NETWORK=regtest

# Optional: pin a specific wallet mnemonic instead of auto-generating one.
# Leave unset to have the app generate and persist a fresh one automatically.
# WALLET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
EOF