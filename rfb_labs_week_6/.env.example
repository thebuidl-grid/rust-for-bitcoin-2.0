# Copy to `.env` and adjust. `init` will also create/append to `.env` itself the first
# time it generates a mnemonic, so for a first run you often don't need to touch this file
# beyond the RPC settings below.

BITCOIN_NETWORK=regtest

# bitcoind RPC connection. Either set RPC_COOKIE (the .cookie file bitcoind writes into its
# regtest datadir), or RPC_USER + RPC_PASS if you started bitcoind with -rpcuser/-rpcpassword
# (which is what docker-compose.yml below and most container images do).
RPC_URL=127.0.0.1:18443
# RPC_COOKIE=/path/to/.bitcoin/regtest/.cookie
RPC_USER=rfbuser
RPC_PASS=rfbpass

WALLET_DB=wallet.sqlite

# Left blank on purpose: `init` generates a fresh mnemonic and appends it here itself.
# MNEMONIC="..."

ACCOUNT=0
# wpkh (BIP84, native SegWit) or tr (BIP86, Taproot)
SCRIPT_TYPE=wpkh
