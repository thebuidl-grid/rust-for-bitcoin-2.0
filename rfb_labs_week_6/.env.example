# Copy to .env and fill in. `.env` is gitignored — never commit it.
#   cp .env.example .env && cargo run -- init

# Network: regtest | signet | testnet | testnet4.  Mainnet is refused.
BITCOIN_NETWORK=regtest

# BIP39 seed phrase. Generate one with `cargo run -- init`.
# NEVER commit a real value. NEVER reuse a mainnet seed here.
# Quote it: the value contains spaces, and dotenv stops at the first one.
WALLET_MNEMONIC=""

# Optional BIP39 passphrase (the "25th word"). Leave blank if unused.
WALLET_PASSPHRASE=

# Where wallet state is persisted. Contains private descriptors — gitignored.
WALLET_DB=./wallet.sqlite

# Script type for both keychains: wpkh (BIP84) | tr (BIP86 Taproot)
DESCRIPTOR_KIND=wpkh

# Bitcoin Core RPC. Defaults below are Polar's published regtest credentials,
# which are not secret. Change these for any other node.
RPC_URL=http://127.0.0.1:18443
RPC_USER=polaruser
RPC_PASSWORD=polarpass
