# Copy this to .env and fill in your regtest / testnet values.
# NEVER commit .env to version control.

# Bitcoin Core RPC credentials
RPC_URL=http://127.0.0.1:18443
RPC_USER=bitcoin
RPC_PASS=bitcoin

# Optional: override the wallet DB path (default: wallet.sqlite)
# WALLET_DB=wallet.sqlite

# Optional: BIP-39 mnemonic for wallet import.
# Leave blank to generate a fresh wallet on first run.
# MNEMONIC=word1 word2 ... word12
