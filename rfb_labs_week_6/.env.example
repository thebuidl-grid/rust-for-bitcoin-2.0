# Copy this file to `.env` (already gitignored) and adjust as needed.
# `init` will append a generated MNEMONIC="..." line here the first time you run it —
# never commit that once it's added.

BITCOIN_NETWORK=regtest
RPC_URL=127.0.0.1:18443
RPC_USER=rfbuser
RPC_PASS=rfbpass
# RPC_COOKIE=/path/to/.cookie   # alternative to RPC_USER/RPC_PASS
WALLET_DB=wallet.sqlite
DESCRIPTOR_KIND=wpkh
ACCOUNT=0
# PASSPHRASE=                  # optional BIP39 passphrase
# MNEMONIC=                    # set automatically by `init`; do not commit a real value
