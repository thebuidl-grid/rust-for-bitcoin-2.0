# Copy this file to .env and fill in real values (or let the wallet
# generate WALLET_XPRV for you on first run). .env is gitignored --
# never commit real keys or your API key.

# Populated automatically on first `cargo run` if left unset.
WALLET_XPRV=

# BitRPC (https://bitrpc.thebuidl.xyz) -- MAINNET Bitcoin Core proxy.
# Get your key from https://bitrpc.thebuidl.xyz/dashboard after logging in.
BITRPC_API_KEY=
# Only override if your instructor gives you a different endpoint.
BITRPC_URL=https://bitrpc.thebuidl.xyz/bitcoin