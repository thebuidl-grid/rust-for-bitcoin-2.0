# Copy this file to .env and fill in your own values. .env is gitignored and never committed.

# Bitcoin Core JSON-RPC endpoint (regtest default port is 18443).
BITCOIN_RPC_URL=http://127.0.0.1:18443
# RPC credentials, matching rpcuser/rpcpassword (or a rpcauth entry) in your bitcoin.conf.
BITCOIN_RPC_USER=changeme
BITCOIN_RPC_PASSWORD=changeme

# Bitcoin network. This wallet is built and demoed on regtest only.
NETWORK=regtest

# Where the wallet's local SQLite database lives. Holds BDK's wallet state (descriptors, address
# indices, transactions, UTXOs) plus the wallet's BIP39 seed phrase. Never commit this file.
DATABASE_URL=data/wallet.db
