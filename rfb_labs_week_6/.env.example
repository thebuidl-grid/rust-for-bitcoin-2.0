# Copy to .env and adjust as needed. If WALLET_MNEMONIC is left unset, the app generates a
# fresh disposable test mnemonic on first run and appends it here automatically.

# BITCOIN_NETWORK=regtest
# WALLET_MNEMONIC="twelve disposable test words go here ..."
# WALLET_PASSPHRASE=
# WALLET_DB_PATH=wallet.sqlite

# RPC_URL=127.0.0.1:18443
# RPC_USER=polaruser
# RPC_PASS=polarpass
