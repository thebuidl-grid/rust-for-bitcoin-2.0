# Copy this to `.env` only if you want to hand-edit it. In normal use you don't need to: running
# `cargo run -- init` generates a fresh wallet and writes a real `.env` for you (which is
# .gitignored and must never be committed).

# regtest | testnet | signet | bitcoin
BITCOIN_NETWORK=regtest

# Where the wallet's SQLite chain state / UTXO set / tx history live.
BDK_DB_PATH=wallet.sqlite

# External (receiving) keychain descriptor. Contains private key material — treat as a secret.
DESCRIPTOR=

# Internal (change) keychain descriptor. Also private key material.
CHANGE_DESCRIPTOR=

# bitcoind JSON-RPC endpoint.
RPC_URL=127.0.0.1:18443

# Cookie-file auth (default for a local regtest/testnet node with no rpcauth configured).
RPC_COOKIE=/home/blackghost/.bitcoin/regtest/.cookie

# Alternative to RPC_COOKIE: explicit user/pass auth.
# RPC_USER=
# RPC_PASS=
