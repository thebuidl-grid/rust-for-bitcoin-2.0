# Bitcoin Wallet Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file - it contains sensitive information!

# Bitcoin Network Selection
# Options: regtest (local testing), testnet (public testnet), mainnet (production)
# For development, use "regtest" with a local bitcoind instance
BITCOIN_NETWORK=regtest

# Bitcoin Core RPC Endpoint
# This is where your Bitcoin Core node is running
# regtest: http://127.0.0.1:18332
# testnet: http://127.0.0.1:18332 (or use a public RPC service)
# mainnet: http://127.0.0.1:8332
RPC_URL=http://127.0.0.1:18332

# Bitcoin Core RPC Authentication
# These must match your bitcoind configuration
# Found in: ~/.bitcoin/bitcoin.conf
# Or passed as: bitcoind -rpcuser=bitcoin -rpcpassword=testpassword
RPC_USERNAME=bitcoin
RPC_PASSWORD=testpassword

# Wallet Database Path
# SQLite database file location for storing wallet state
# The directory must be writable
# Path: relative to working directory or absolute path
DB_PATH=./wallet.db

# BIP39 Seed Phrase (12 or 24 words)
# IMPORTANT: This is HIGHLY SENSITIVE - keep it secret!
#
# Generate a test phrase here: https://iancoleman.io/bip39/
#
# For development, you can use this test phrase:
# "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
# (This is a well-known test phrase - NEVER use this for real Bitcoin!)
#
# For production, generate with: bip39-en-256 (24 words) or bip39-en-128 (12 words)
#
# Format: space-separated words
SEED_PHRASE=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# Logging Level
# Options: TRACE, DEBUG, INFO, WARN, ERROR
# INFO is recommended for normal operation
RUST_LOG=info

# Optional: Wallet Name (for identification)
WALLET_NAME=MyTestWallet

# Optional: Derivation Path for custom wallets
# Standard path: m/84'/0'/0' (BIP44 native SegWit)
# This is set in the code but could be extended for config
# DERIVATION_PATH=m/84'/0'/0'

# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your settings:
#    nano .env
#
# 3. Make sure Bitcoin Core is running:
#    bitcoind -regtest -rpcuser=bitcoin -rpcpassword=testpassword
#
#    Or with Docker:
#    docker run -p 18332:18332 kylemanna/bitcoind -regtest
#
# 4. Run wallet:
#    cargo run -- init
#    cargo run -- balance
#    cargo run -- address
#
# ============================================
# QUICK START FOR REGTEST
# ============================================
#
# Terminal 1 - Start Bitcoin Core:
# bitcoind -regtest -server -rpcuser=bitcoin -rpcpassword=testpassword
#
# Terminal 2 - Initialize wallet:
# cargo run -- init --seed "your 12 word phrase"
#
# Terminal 3 - Send Bitcoin to wallet:
# bitcoin-cli -regtest sendtoaddress bc1qXXXXXXXXXXXXXXXXXXXXXXX 0.5
#
# Check balance:
# cargo run -- balance
#
# ============================================
