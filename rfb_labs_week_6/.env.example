# Copy this file to .env and fill in real values. Never commit .env.

# regtest | testnet
BITCOIN_NETWORK=regtest

# host:port of the bitcoind RPC server (regtest default is 127.0.0.1:18443)
RPC_URL=127.0.0.1:18443

# Auth: either point at bitcoind's cookie file, or set user/pass.
# Leave RPC_COOKIE_FILE set and RPC_USER/RPC_PASS empty to use cookie auth.
RPC_COOKIE_FILE=
RPC_USER=
RPC_PASS=

# Path to the local wallet SQLite database (created on first run).
WALLET_DB_PATH=wallet.sqlite

# Optional: a BIP39 mnemonic to derive the wallet from. Leave empty on
# first run and the program will generate a fresh one and print it once
# so you can save it here for future runs. NEVER commit a real mnemonic.
MNEMONIC=
