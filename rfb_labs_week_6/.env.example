# Copy to .env and fill in. .env is gitignored; never commit a real seed.

# regtest (default), testnet or signet. Mainnet is refused.
RFB_NETWORK=regtest

# Bitcoin Core JSON-RPC endpoint. These defaults match the node that
# ./scripts/regtest-node.sh starts. Without RFB_RPC_URL the standard port for the
# network is used.
RFB_RPC_URL=http://127.0.0.1:18449

# Authentication. Either a user/password pair...
RFB_RPC_USER=rfb
RFB_RPC_PASSWORD=rfbregtest
# ...or a path to bitcoind's cookie file. If neither is set, the cookie in the
# default datadir for this network is used.
# RFB_RPC_COOKIE=/Users/you/Library/Application Support/Bitcoin/regtest/.cookie

# Where the SQLite wallet database lives.
RFB_WALLET_DB=data/wallet.sqlite

# BIP39 seed. Generate one with `cargo run -- new-mnemonic`.
# This is the only copy of the wallet's private keys: the database stores
# public descriptors only. Without it the wallet opens read-only.
RFB_MNEMONIC="twelve words go here ..."

# Optional BIP39 passphrase. Changing it produces a completely different wallet.
# RFB_PASSPHRASE=

# Optional log filter, e.g. RFB_LOG=debug
# RFB_LOG=
